{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "destination": "/lucas-jacquot",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/lucas-jacquot",
      "destination": "/portfolio-cine/"
    },
    {
      "source": "/lucas-jacquot/photos",
      "destination": "/portfolio-cine/photos"
    },
    {
      "source": "/lucas-jacquot/(.*)",
      "destination": "/portfolio-cine/$1"
    }
  ]
}
